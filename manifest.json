{
  "manifest_version": 3,
  "name": "Tab Groups Panel",
  "version": "1.0.0",
  "description": "Side panel listing tab groups with full tab titles, rule-based auto-grouping, and sleeping or parking whole groups.",
  "permissions": ["tabs", "tabGroups", "sidePanel", "storage", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Tab Groups Panel"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open the tab groups panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
